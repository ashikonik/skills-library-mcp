# The skills and the agents ARE this repository. They are tracked.

# Third-party clones with their own .git -- a nested repo would become
# a gitlink and break this repository's history.
ponytail/.git
mattpocock-skills/.git

# Python
__pycache__/
*.pyc

# Node
mcp/node_modules/
mcp/dist/

# Build artefacts -- the index is derived from the tree, so it is
# rebuilt rather than tracked.
mcp/data/index.json

# The rendered documents. Their source is the template in
# `mcp/docs/templates/`; the number in them is read from the index, so
# a committed copy would be a number that drifts out of date silently.
mcp/README.md
mcp/docs/ARCHITECTURE.md
mcp/docs/REGISTERING.md
mcp/docs/TOOL_REFERENCE.md

# Per-step build logs and their snapshots.
logs/

# The project's policy file and install manifest. These are written by
# the server at run time: the manifest records the paths *this* clone's
# installs wrote, and the policy file says what this project allows.
# Both are per-machine state, not source.
mcp/.skills-library/
